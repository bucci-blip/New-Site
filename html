<div class="container">
<h1 id="foryou" style="color:rgb(255, 255, 255)">細渕的MUSIC診断♪</h1>

<div class="progress">
  <div class="progress-bar" id="bar"></div>
</div>

<!-- Q1 -->
<div class="screen active" id="q0">
<p style="color:rgb(255, 255, 255)">どんな音が好き？</p>
<button onclick="next('heavy')" style="color:rgb(255, 255, 255)">ジメジメ</button>
<button onclick="next('light')" style="color:rgb(255, 255, 255)">カラカラ</button>
<button class="back-btn" onclick="back()">⏮戻る</button>
</div>

<!-- Q2 -->
<div class="screen" id="q1">
<p style="color:rgb(255, 255, 255)">音楽を聴くとき...</p>
<button onclick="next('groove')" style="color:rgb(255, 255, 255)">全身でノりたい</button>
<button onclick="next('still')" style="color:rgb(255, 255, 255)">静かに聴きます</button>
<button class="back-btn" onclick="back()">⏮戻る</button>
</div>

<!-- Q3 -->
<div class="screen" id="q2">
<p style="color:rgb(255, 255, 255)">不穏な音楽は？</p>
<button onclick="next('weird')" style="color:rgb(255, 255, 255)">好き</button>
<button onclick="next('normal')" style="color:rgb(255, 255, 255)">べつに</button>
<button class="back-btn" onclick="back()">⏮戻る</button>
</div>

<!-- Q4 -->
<div class="screen" id="q3">
<p style="color:rgb(255, 255, 255)">浸れるのはどっち？</p>
<button onclick="next('night')" style="color:rgb(255, 255, 255)">夜</button>
<button onclick="next('day')" style="color:rgb(255, 255, 255)">昼</button>
<button class="back-btn" onclick="back()">⏮戻る</button>
</div>

