/* コンテナ */
.container {
  position: relative;
  width: 90%;
  max-width: 600px;
  margin: 40px auto;
  padding: 30px;
  backdrop-filter: blur(12px);
  background: rgba(75, 100, 44, 0.3);
  border-radius: 20px;
  text-align: center
}

/* 質問画面 */
.screen {
  display: none;
  animation: fadeSlide 0.8s;
}

.active {
  display: block;
}

@keyframes fadeSlide {
  from { opacity: 0; transform: translateX(30px);}
  to { opacity: 1; transform: translateX(0);}
}

/* ボタン */
button {
  display: block;
  width: 80%;
  margin: 10px auto;
  padding: 12px;
  border-radius: 30px;
  border: none;
  background: rgba(255, 255, 255, 0.24);
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  background: rgba(227, 168, 6, 0.892);
  color: rgb(255, 255, 255);
  transform: scale(1.05);
}

.back-btn {
  background: transparent;
  border: none;
  color: white;
  font-size: 14px;
  cursor: pointer;
  width: auto;
  margin: 10px auto;
  display: block;
  text-decoration: underline;
  transform: none !important;
}

.back-btn:hover {
  color: #ffa216;
  background: transparent;
  transform: none;
}

/* 進行バー */
.progress {
  height: 5px;
  background: rgba(0,0,0,0.1);
  margin-bottom: 20px;
  border-radius: 10px;
}

.progress-bar {
  height: 100%;
  width: 0%;
  background: #ffa216;
  transition: 0.5s;
}

.button{
  color:#ffffff;

}
button.selected {
  background: #477d2d;
  color: white;
  transform: scale(1.05);
}

/* 結果 */
#result {
  display: none;
  animation: fadeSlide 1s;
}
.retry-btn{
color:#ffffff;
}
.song-card {
  transform:scale(1.05);
  transition:0.3s;
}

