/*haikei  */
body::before {
  content: "";
  position:fixed;
  top:0;
  left:0;
  width: 100%;
  height: 100%;
  background-image: url(./pexels-clouds-1846190.jpg ) ;
  background-size: auto;
  background-position: center;
  z-index: -1;
 
}


body{
  transition:background 1s ease;

  a {
  color: white;        
  text-decoration: none;  
  font-size: medium;
}

a:visited {
  color: white;           /* 訪問後 */
}

a:hover {
  color: #ffa216;         /* ホバー時 */
}

}
